{
  "name": "imposter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "seed:words": "node scripts/seedWords.mjs",
    "test": "node --test tests/engine.test.js tests/settings.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules.test.js\"",
    "deploy": "npm run build && firebase deploy",
    "build:mobile": "vite build && cap sync",
    "cap:sync": "cap sync",
    "android": "npm run build:mobile && cap open android",
    "ios": "npm run build:mobile && cap open ios",
    "android:run": "npm run build:mobile && cap run android",
    "ios:run": "npm run build:mobile && cap run ios",
    "icons": "capacitor-assets generate --android --ios"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "firebase": "^12.6.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
