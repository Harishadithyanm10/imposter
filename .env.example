# Firebase WEB config (free Spark plan is enough). These values are public identifiers, not secrets.
# Copy to .env.local and fill in from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# Set to "true" to use the local Firebase Emulator Suite (Auth + Firestore)
VITE_USE_EMULATORS=false

# Mobile apps only: the public https address of your deployed website. Used in "Share invite" links,
# because inside the apps the page address is capacitor://localhost.  e.g. https://your-site.netlify.app
VITE_PUBLIC_URL=
